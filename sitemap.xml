---
layout: null
sitemap: false
---
{% comment %}
  The sitemap, written here instead of generated by jekyll-sitemap so that it lists only pages meant for search:
  posts, projects, categories and the site's pages. Tag and year archives, news items and the blog's numbered pages
  are left out (tags, years and news are marked noindex in _includes/metadata.liquid).
{% endcomment %}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for post in site.posts -%}
    {%- unless post.sitemap == false -%}
      <url>
        <loc>{{ post.url | absolute_url | xml_escape }}</loc>
        <lastmod>{{ post.last_updated | default: post.date | date_to_xmlschema }}</lastmod>
      </url>
    {%- endunless -%}
  {%- endfor -%}
  {%- for project in site.projects -%}
    {%- unless project.sitemap == false -%}
      <url>
        <loc>{{ project.url | absolute_url | xml_escape }}</loc>
      </url>
    {%- endunless -%}
  {%- endfor -%}
  {%- for page in site.html_pages -%}
    {%- if page.sitemap == false or page.type == 'tag' or page.type == 'year' -%}{%- continue -%}{%- endif -%}
    {%- if page.url contains '/page/' or page.url == '/404.html' or page.layout == 'redirect' -%}{%- continue -%}{%- endif -%}
    <url>
      <loc>{{ page.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    </url>
  {%- endfor -%}
</urlset>
