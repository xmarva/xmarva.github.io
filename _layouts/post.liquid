---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign url_beginning = page.url | slice: 0, 6 %}

{% assign read_time = content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}

<div class="post post-page">
  <header class="post-header{% if page.thumbnail %} has-cover{% endif %}">
    {% assign lesson_number = nil %}{% assign lesson_course = nil %}
    {% for c in site.data.courses %}{% for l in c.lessons %}{% if l.url == page.url %}{% assign lesson_number = forloop.index %}{% assign lesson_course = c %}{% endif %}{% endfor %}{% endfor %}
    {% assign main_category = page.categories | first %}
    {% if lesson_course %}
      <p class="post-kicker"><a href="{{ '/teaching/' | relative_url }}">{{ lesson_course.badge | default: 'Course' | downcase }} · lesson {{ lesson_number }} of {{ lesson_course.lessons.size }}</a></p>
    {% elsif main_category %}
      <p class="post-kicker"><a href="{{ main_category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">{{ main_category | replace: '-', ' ' }}</a></p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% assign dek = page.dek | default: page.description | split: '. ' | first | strip %}
    {% if dek != '' %}
      {% assign dek_end = dek | slice: -1, 1 %}
      <p class="post-dek">{{ dek }}{% unless dek_end == '.' or dek_end == '?' or dek_end == '!' %}.{% endunless %}</p>
    {% endif %}
    <p class="post-meta post-byline">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %-d, %Y' }}</time>
      {% comment %} an update on the day of publication says nothing new {% endcomment %}
      {% assign published_day = page.date | date: '%Y-%m-%d' %}
      {% assign updated_day = page.last_updated | date: '%Y-%m-%d' %}
      {% if page.last_updated and updated_day != published_day %}
        <span aria-hidden="true">&middot;</span> updated {{ page.last_updated | date: '%B %-d, %Y' }}
      {% endif %}
      <span aria-hidden="true">&middot;</span> {{ read_time }} min read
      {% include social_icons.liquid %}
    </p>
    {% if page.thumbnail %}
      {% assign art_path = page.thumbnail | replace: 'cover.png', 'cover-art.png' %}
      {% assign art = site.static_files | where: 'path', art_path | first %}
      {% if art %}
        <figure class="post-cover post-art">
          {% include cover_img.liquid src=art_path width=1200 height=960 priority=true %}
        </figure>
      {% else %}
        <figure class="post-cover">
          {% include cover_img.liquid src=page.thumbnail priority=true %}
        </figure>
      {% endif %}
    {% endif %}
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <details id="table-of-contents" class="post-toc">
        <summary>Contents</summary>
        <nav aria-label="Contents">
          {% toc %}
        </nav>
      </details>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if tags != '' and url_beginning == '/blog/' %}
    <p class="post-tags-end">
      {% for tag in page.tags %}<a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">#{{ tag }}</a>{% endfor %}
    </p>
  {% endif %}

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% include course_nav.liquid %}

  {% if site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

<script defer src="{{ '/assets/js/post-references.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/code-fold.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/citations.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/link-previews.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/side-toc.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/figures.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/openers.js' | relative_url | bust_file_cache }}"></script>
