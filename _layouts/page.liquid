---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post{% if page.cover %} post-page{% endif %}">
  {% if page.hide_header %}
  <h1 class="sr-only">{{ page.title }}</h1>
  {% else %}
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.cover %}
      <figure class="post-cover">
        <img src="{{ page.cover | relative_url }}" alt="" width="1200" height="630" fetchpriority="high" decoding="async">
      </figure>
      <p class="post-meta post-byline">
        {{- page.role -}}
        {%- if page.period %}
          <span aria-hidden="true">&middot;</span> {{ page.period -}}
        {%- endif -%}
        {%- if page.domains %}
          <span aria-hidden="true">&middot;</span> {{ page.domains | join: ', ' -}}
        {%- endif -%}
      </p>
    {% else %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>
  {% endif %}

  <article>
    {% if page.cover %}
      <div id="markdown-content">
        {{ content }}
      </div>
    {% else %}
      {{ content }}
    {% endif %}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
{% if page.cover %}
  <script defer src="{{ '/assets/js/post-references.js' | relative_url | bust_file_cache }}"></script>
  <script defer src="{{ '/assets/js/citations.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
