{% comment %}
  A course's progress: a segment per lesson, red when it is out, and how many are out.
  include.course: an entry of _data/courses.yml
{% endcomment %}
{% assign progress_done = include.course.lessons | where_exp: 'lesson', 'lesson.url' | size %}
{% assign progress_total = include.course.lessons | size %}
<div class="course-progress">
  <span class="course-bar" aria-hidden="true">{% for lesson in include.course.lessons %}<span{% if lesson.url %} class="on"{% endif %}></span>{% endfor %}</span>
  <span class="course-progress-label">{% if progress_done == progress_total %}{{ progress_total }} lessons{% elsif progress_done > 0 %}{{ progress_done }} of {{ progress_total }} lessons out{% else %}{{ progress_total }} lessons planned, the first one coming soon{% endif %}</span>
</div>
