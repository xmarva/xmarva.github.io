{% comment %} only load MathJax where there is math (kramdown renders $$...$$ as \(...\) and \[...\]) {% endcomment %}
{% if site.enable_math %}
  {% if content contains '\(' or content contains '\[' or content contains '$$' %}
    {% unless page.pseudocode %}
      <!-- MathJax -->
      <script type="text/javascript">
        window.MathJax = {
          tex: {
            tags: 'ams',
          },
          chtml: {
            // words inside formulas in the serif of the text, also in a formula set on its own line
            mtextFont: '"Charis SIL", Charter, Georgia, serif',
          },
          startup: {
            // a comma or a full stop after a formula stays on the formula's line
            pageReady: function () {
              return MathJax.startup.defaultPageReady().then(function () {
                var formulas = document.querySelectorAll('mjx-container:not([display="true"])');
                for (var i = 0; i < formulas.length; i++) {
                  var math = formulas[i];
                  var next = math.nextSibling;
                  var mark = next && next.nodeType === 3 ? next.data.match(/^[,.;:!?)\]]+/) : null;
                  if (!mark) continue;
                  next.data = next.data.slice(mark[0].length);
                  var glue = document.createElement('span');
                  glue.className = 'math-glue';
                  math.parentNode.insertBefore(glue, math);
                  glue.appendChild(math);
                  glue.appendChild(document.createTextNode(mark[0]));
                }
              });
            },
          },
        };
      </script>
      <script
        defer
        type="text/javascript"
        id="MathJax-script"
        src="{{ site.third_party_libraries.mathjax.url.js }}"
        integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
        crossorigin="anonymous"
      ></script>
    {% endunless %}
  {% endif %}
{% endif %}
