{% comment %}
  One row of the blog list: the cover on the left, kept at its 1200x630 shape so nothing on it is cut off, and
  the text on the right. The title link is stretched over the whole row (Bootstrap's .stretched-link), so the row
  is clickable without nesting the category link inside another <a>.
{% endcomment %}
{% assign post = include.post %}
{% if post.external_source == blank %}
  {% assign read_time = post.content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
{% else %}
  {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
{% endif %}
{% assign category = post.categories | first %}

<article class="post-row">
  <div class="post-row-thumb{% unless post.thumbnail %} post-row-thumb-empty{% endunless %}">
    {% if post.thumbnail %}
      <img src="{{ post.thumbnail | relative_url }}" alt="" width="1200" height="630" loading="lazy" decoding="async">
    {% else %}
      <span>{{ category | default: 'blog' }}</span>
    {% endif %}
  </div>
  <div class="post-row-body">
    <p class="post-row-meta">
      {% if include.featured %}
        <span class="post-row-pin"><i class="fa-solid fa-thumbtack fa-xs"></i> Pinned</span>
        <span aria-hidden="true">&middot;</span>
      {% endif %}
      <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %-d, %Y' }}</time>
      <span aria-hidden="true">&middot;</span>
      {{ read_time }} min read
      {% if category %}
        <span aria-hidden="true">&middot;</span>
        <a href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">{{ category }}</a>
      {% endif %}
    </p>
    <h3 class="post-row-title">
      <a class="stretched-link" href="{{ post.url | relative_url }}">{{ post.title }}</a>
    </h3>
    {% if post.description %}
      <p class="post-row-desc">{{ post.description }}</p>
    {% endif %}
  </div>
</article>
